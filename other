/**
 * services/attribute_parser.js
 * Card attribute extraction with robust year detection per spec.
 * 
 * - Finds 4-digit years (1940..2027)
 * - Expands 2-digit shorthand with leading apostrophe or slash ('96, /03) using a strict window:
 *      yy >= 40 -> 1900 + yy, else -> 2000 + yy
 * - Handles season forms like 1999-00 -> extracts 1999
 * - Returns deduped, sorted years array in the final object.
 */

function toLines(input) {
  if (!input) return [];
  if (Array.isArray(input)) return input.map(l => (l || '').toString()).filter(Boolean);
  return input.toString().split(/\r?\n/).map(s => s.trim()).filter(Boolean);
}

function expandTwoDigitYear(twoDigitStr) {
  const n = parseInt(twoDigitStr, 10);
  if (Number.isNaN(n)) return null;
  return n >= 40 ? 1900 + n : 2000 + n;
}

function parseAttributes(raw) {
  const lines = toLines(raw);
  const fullText = lines.join('\n') || '';
  if (!fullText.trim()) {
    return {
      years: [],
      cardNumbers: [],
      premium: { auto: false, autograph: false, patch: false, refractor: false, prizm: false, oneOfOne: false },
      rawMatches: {}
    };
  }

  const MIN_YEAR = 1940;
  const MAX_YEAR = 2027;

  const yearsSet = new Set();
  const yearRawMatches = [];

  // 1) 4-digit years (19xx, 20xx) limited to MIN_YEAR..MAX_YEAR
  const year4Regex = /\b(19|20)\d{2}\b/g;
  let m;
  while ((m = year4Regex.exec(fullText)) !== null) {
    const y = parseInt(m[0], 10);
    if (y >= MIN_YEAR && y <= MAX_YEAR) {
      yearsSet.add(String(y));
      yearRawMatches.push(m[0]);
    }
  }

  // 2) Season style 1999-00 or 1999/00 -> take first 4-digit year
  const seasonRegex = /\b(19|20)\d{2}[-\/]\d{2}\b/g;
  while ((m = seasonRegex.exec(fullText)) !== null) {
    const firstYear = parseInt(m[0].slice(0, 4), 10);
    if (firstYear >= MIN_YEAR && firstYear <= MAX_YEAR) {
      yearsSet.add(String(firstYear));
      yearRawMatches.push(m[0]);
    }
  }

  // 3) Two-digit shorthand with leading apostrophe or slash: '96, `96, /03
  const twoDigitShortRegex = /(?:['\u2019\/])\s*(\d{2})\b/g;
  while ((m = twoDigitShortRegex.exec(fullText)) !== null) {
    const yy = m[1];
    const expanded = expandTwoDigitYear(yy);
    if (expanded && expanded >= MIN_YEAR && expanded <= MAX_YEAR) {
      yearsSet.add(String(expanded));
      yearRawMatches.push(m[0]);
    }
  }

  // 4) Two-digit season style e.g., 03-04 or 99/00 -> interpret first pair as shorthand
  const twoDigitSeasonRegex = /\b(\d{2})[-\/](\d{2})\b/g;
  while ((m = twoDigitSeasonRegex.exec(fullText)) !== null) {
    const first = m[1];
    const expanded = expandTwoDigitYear(first);
    if (expanded && expanded >= MIN_YEAR && expanded <= MAX_YEAR) {
      yearsSet.add(String(expanded));
      yearRawMatches.push(m[0]);
    }
  }

  // Card number extraction (kept robust)
  const cardNumbers = new Set();
  const numberRawMatches = [];

  const hashRegex = /#\s*(\d{1,4})\b/g;
  while ((m = hashRegex.exec(fullText)) !== null) { numberRawMatches.push(m[0]); }

  const noRegex = /\bNo\.?[:\s]*?(\d{1,4})\b/gi;
  while ((m = noRegex.exec(fullText)) !== null) { numberRawMatches.push(m[0]); }

  const labeledNumberRegex = /\b(?:Card|Number|Num|Nr)[:\s]*?(\d{1,4})\b/gi;
  while ((m = labeledNumberRegex.exec(fullText)) !== null) { numberRawMatches.push(m[0]); }

  const slashNumRegex = /\b(\d{1,4})\s*[\/]\s*(\d{1,4})\b/g;
  while ((m = slashNumRegex.exec(fullText)) !== null) { numberRawMatches.push(m[0]); }

  const ofNumRegex = /\b(\d{1,4})\s+(?:of|OF)\s+(\d{1,4})\b/g;
  while ((m = ofNumRegex.exec(fullText)) !== null) { numberRawMatches.push(m[0]); }

  const isolatedDigitRegex = /\b(\d{1,4})\b/g;
  for (const line of lines) {
    if (line.length < 30 || /\b(?:card|no\.?|number|num)\b/i.test(line)) {
      let lm;
      while ((lm = isolatedDigitRegex.exec(line)) !== null) {
        const val = lm[1];
        if (/^(19|20)\d{2}$/.test(val)) continue; // skip years
        cardNumbers.add(String(parseInt(val, 10)));
        numberRawMatches.push(lm[0]);
      }
    }
  }

  // Premium flags
  const premiumKeywords = {
    auto: [/\bauto(?:graph[ed]?)?s?\b/i, /\bautograph\b/i],
    autograph: [/\bautograph\b/i, /\bautographed\b/i],
    patch: [/\bpatch\b/i, /\bpatches\b/i],
    refractor: [/\brefractor\b/i, /\brefractors\b/i],
    prizm: [/\bprizm\b/i, /\bprizms\b/i],
    oneOfOne: [/\b1\s*[\/]\s*1\b/i, /\b1\s+of\s+1\b/i, /\b1of1\b/i]
  };

  const premium = { auto: false, autograph: false, patch: false, refractor: false, prizm: false, oneOfOne: false };
  for (const key of Object.keys(premiumKeywords)) {
    const patterns = premiumKeywords[key];
    for (const pat of patterns) {
      if (pat.test(fullText)) { premium[key] = true; break; }
    }
  }

  // Finalize years: dedupe and sort numeric ascending
  const yearsArr = Array.from(yearsSet).map(s => parseInt(s, 10)).filter(y => !isNaN(y)).sort((a, b) => a - b);

  return {
    years: yearsArr,
    cardNumbers: Array.from(cardNumbers),
    premium,
    rawMatches: {
      yearMatches: yearRawMatches,
      numberMatches: numberRawMatches
    }
  };
}

module.exports = { parseAttributes };
