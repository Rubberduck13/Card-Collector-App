class WalletEngine {
  constructor() {
    this.valueForItem = valueForItem;
    this.portfolioStats = portfolioStats;
  }
  
  pricingReport(config) {
    const baseline = this.valueForItem({
      gradingReport: { grade: config.numericGrade },
      name: config.cardName
    });
    return { finalValuation: baseline };
  }
}

module.exports = new WalletEngine();
