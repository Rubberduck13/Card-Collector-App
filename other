// services/storage_engine.js
// Simple JSON-backed storage utilities for Phase 1: data/database.json
const fs = require('fs');
const path = require('path');

const dbDir = path.join(__dirname, '..', 'data');
const dbPath = path.join(dbDir, 'database.json');

function ensureDB() {
  try {
    if (!fs.existsSync(dbDir)) fs.mkdirSync(dbDir, { recursive: true });
    if (!fs.existsSync(dbPath)) fs.writeFileSync(dbPath, JSON.stringify({ inventory: [], categoryCounts: {} }));
  } catch (err) {
    // If we cannot create folders/files, bubble up read/write permissions issue
    throw err;
  }
}

function readDB() {
  ensureDB();
  try {
    const raw = fs.readFileSync(dbPath, 'utf8');
    if (!raw) return { inventory: [], categoryCounts: {} };
    const parsed = JSON.parse(raw);
    if (!parsed || typeof parsed !== 'object') return { inventory: [], categoryCounts: {} };
    if (!Array.isArray(parsed.inventory)) parsed.inventory = [];
    if (!parsed.categoryCounts || typeof parsed.categoryCounts !== 'object') parsed.categoryCounts = {};
    return parsed;
  } catch (err) {
    // If corrupt, recreate with safe default
    const fallback = { inventory: [], categoryCounts: {} };
    try { fs.writeFileSync(dbPath, JSON.stringify(fallback, null, 2), 'utf8'); } catch(e) {}
    return fallback;
  }
}

function writeDB(db) {
  ensureDB();
  fs.writeFileSync(dbPath, JSON.stringify(db, null, 2), 'utf8');
}

async function getAllCards() {
  const db = readDB();
  return db.inventory || [];
}

async function saveCard(item) {
  if (!item) throw new Error('item required');
  const db = readDB();
  db.inventory = db.inventory || [];
  db.inventory.unshift(item);
  
  // Optionally update categoryCounts if item.category present
  const key = (item.category && typeof item.category === 'string') ? item.category : null;
  if (key) {
    db.categoryCounts = db.categoryCounts || {};
    db.categoryCounts[key] = (db.categoryCounts[key] || 0) + 1;
  }
  writeDB(db);
  return item;
}

module.exports = { getAllCards, saveCard, readDB, writeDB };
